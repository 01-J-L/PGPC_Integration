# Copy this file to .env and fill in real values.
# Generate a secret key with: py -c "import secrets; print(secrets.token_hex(32))"

# --- Flask core ---
FLASK_SECRET_KEY=
GRADING_SECRET_KEY=
FLASK_DEBUG=True

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expired
DB_USER=root
DB_PASSWORD=

# --- Mail / SMTP ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER_EMAIL=
MAIL_DEFAULT_SENDER_NAME=Padre Garcia Polytechnic College
MAIL_SENDER_NAME=Padre Garcia Polytechnic College
ADMIN_EMAIL=

# --- Server ---
# FLASK_SERVER_NAME=
FLASK_PREFERRED_URL_SCHEME=http
